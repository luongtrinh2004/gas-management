# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/gas

# Khóa ký phiên đăng nhập — BẮT BUỘC khi chạy production.
# Tạo chuỗi ngẫu nhiên: openssl rand -base64 48
AUTH_SECRET=

# Mật khẩu khởi tạo cho 4 tài khoản của `npm run seed` (để trống = tự sinh ngẫu nhiên và in ra một lần)
SEED_PASSWORD=

# Optional: serve the app under a sub-path
BASEPATH=
